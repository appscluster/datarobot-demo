# Backend with the optional LightRAG retrieval backend (docker compose --profile lightrag)
FROM python:3.11-slim
WORKDIR /app
COPY backend/requirements.txt backend/requirements-lightrag.txt /app/
RUN pip install --no-cache-dir -r /app/requirements.txt -r /app/requirements-lightrag.txt
COPY agent /app/agent
COPY backend /app/backend
COPY data /app/data
COPY scripts /app/scripts
ENV PYTHONPATH=/app
EXPOSE 54123
CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "54123"]
